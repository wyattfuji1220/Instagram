# Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Instagram Graph API
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAA...

# GitHub Pages のベースURL（画像の公開URLに使う）
PAGES_BASE_URL=https://wyattfuji1220.github.io/Instagram

# 任意: Graph API バージョン
GRAPH_API_VERSION=v23.0

# 認証方式。Instagram ログイン方式なら https://graph.instagram.com
# Facebook ログイン方式なら https://graph.facebook.com（既定値）
IG_API_HOST=https://graph.instagram.com

# 楽天ブックスAPI の applicationId。和書の内容紹介の取得率が大きく上がる。
# https://webservice.rakuten.co.jp/ で無料登録して発行する。
RAKUTEN_APP_ID=

# 任意: Google Books API キー。匿名アクセスが429で弾かれる環境で有効。
# https://console.cloud.google.com/ で Books API を有効化して発行する。
GOOGLE_BOOKS_API_KEY=
