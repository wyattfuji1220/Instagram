<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  :root {
    --ink: #FFFFFF;
    --ink-dim: #D6D2CA;
    --hl: #F2C14E;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: #0A0A0A;
    color: var(--ink);
    font-family: "Noto Serif JP", "Noto Serif CJK JP", "Hiragino Mincho ProN",
                 "Yu Mincho", "YuMincho", serif;
    -webkit-font-smoothing: antialiased;
  }

  .story { position: relative; width: {{ width }}px; height: {{ height }}px; }

  .bg {
    position: absolute; inset: -50px;
    background-image: url("{{ bg }}");
    background-size: cover; background-position: center;
    filter: blur(6px) brightness(0.6) saturate(0.85);
  }
  .veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,
      rgba(6, 6, 8, 0.74) 0%, rgba(6, 6, 8, 0.46) 40%,
      rgba(6, 6, 8, 0.62) 72%, rgba(6, 6, 8, 0.88) 100%);
  }

  .layer {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 上下はUIに隠れるため、安全域を大きめに取る */
    padding: 300px 90px 260px;
    text-align: center;
  }

  .label {
    font-size: 38px;
    letter-spacing: 0.16em;
    color: var(--hl);
    margin-bottom: 56px;
  }

  .cover {
    width: 500px; height: 715px;
    background-image: url("{{ cover_image }}");
    background-size: cover; background-position: center;
    background-color: #16161A;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    flex: 0 0 auto;
  }
  .cover.placeholder {
    display: flex; align-items: center; justify-content: center;
    padding: 46px; border: 1px solid #3A3A40;
    font-size: 46px; line-height: 1.7; color: var(--ink-dim);
  }

  .title {
    margin-top: 62px;
    font-size: 64px;
    font-weight: 700;
    line-height: 1.6;
    text-wrap: balance;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }
  .author {
    margin-top: 26px;
    font-size: 40px;
    color: var(--ink-dim);
  }

  .spacer { flex: 1; }

  .cta {
    font-size: 46px;
    line-height: 1.6;
    letter-spacing: 0.04em;
    padding: 26px 52px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
  }
  .foot {
    margin-top: 44px;
    display: flex; align-items: center; justify-content: center; gap: 22px;
  }
  .icon {
    width: 76px; height: 76px; border-radius: 50%;
    background-image: url("{{ icon }}");
    background-size: cover; background-position: center;
    background-color: #2A2A2A;
  }
  .icon.letter {
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; color: var(--ink-dim);
  }
  .handle { font-size: 40px; }
</style>
</head>
<body>
  <div class="story">
    <div class="bg"></div>
    <div class="veil"></div>
    <div class="layer">
      <div class="label">{{ label }}</div>

      <div class="cover{{ '' if cover_image else ' placeholder' }}">
        {{ '' if cover_image else book_title }}
      </div>

      <div class="title">{{ book_title }}</div>
      <div class="author">{{ book_author }}</div>

      <div class="spacer"></div>

      <div class="cta">{{ cta }}</div>
      <div class="foot">
        <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
        <span class="handle">{{ handle }}</span>
      </div>
    </div>
  </div>
</body>
</html>
