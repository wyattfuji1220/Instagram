<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  :root {
    --ink: #FFFFFF;
    --ink-dim: #D8D4CC;
    --hl: #F2C14E;          /* 本文のハイライト（黄〜橙） */
    --hl-cover: #D93A2B;    /* 表紙のハイライト（赤） */
    --paper: #FBFAF7;
    --paper-ink: #2B2B2B;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: #0A0A0A;
    color: var(--ink);
    font-family: "Noto Serif JP", "Noto Serif CJK JP", "Hiragino Mincho ProN",
                 "Yu Mincho", "YuMincho", serif;
    -webkit-font-smoothing: antialiased;
  }

  .card {
    position: relative;
    width: {{ width }}px;
    height: {{ height }}px;
    display: flex;
    flex-direction: column;
  }

  /* 背景はぼかして沈める。文字の可読性を最優先にする。 */
  .bg {
    position: absolute;
    inset: -40px;
    background-image: url("{{ bg }}");
    background-size: cover;
    background-position: center;
    filter: blur(4px) brightness(0.78) saturate(0.9);
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at center,
        rgba(6, 6, 8, 0.26) 0%,
        rgba(6, 6, 8, 0.60) 100%
      ),
      linear-gradient(
        180deg,
        rgba(6, 6, 8, 0.62) 0%,
        rgba(6, 6, 8, 0.38) 42%,
        rgba(6, 6, 8, 0.68) 100%
      );
  }

  .layer {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 52px 72px 46px;
  }

  .top-note {
    font-size: 30px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .lead {
    font-size: 54px;
    font-weight: 500;
    line-height: 1.9;
    letter-spacing: 0.02em;
    white-space: pre-line;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
    max-width: 920px;
  }
  .lead.small { font-size: 46px; line-height: 1.95; }
  .hl { color: var(--hl); }

  .foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .icon {
    width: 76px; height: 76px; border-radius: 50%;
    background-image: url("{{ icon }}");
    background-size: cover; background-position: center;
    background-color: #2A2A2A;
    flex: 0 0 auto;
  }
  .icon.letter {
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; color: var(--ink-dim);
  }
  .handle { font-size: 40px; letter-spacing: 0.02em; }

  /* ---------------------------------------------------------------- 表紙 */

  .cover { display: flex; height: 100%; }
  .cover-left {
    width: 62%;
    background: var(--paper);
    color: var(--paper-ink);
    padding: 52px 56px 46px;
    display: flex;
    flex-direction: column;
  }
  .cover-right {
    width: 38%;
    background-image: url("{{ bg }}");
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) contrast(1.1) brightness(0.92);
  }
  .cover-left .top-note { color: #4A4A4A; font-size: 27px; }
  .cover-title {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .cover-title span {
    font-size: 66px;
    font-weight: 700;
    line-height: 1.62;
    letter-spacing: 0.01em;
    white-space: pre-line;
  }
  .cover-title .hl { color: var(--hl-cover); }
  .cover-tag {
    font-size: 32px;
    color: #4A4A4A;
    margin-bottom: 30px;
  }
  .cover-foot { display: flex; align-items: center; gap: 18px; }
  .cover-foot .handle { color: var(--paper-ink); font-size: 38px; }

  /* ------------------------------------------------------------ 書誌情報 */

  .biblio-title {
    margin-top: 34px;
    font-size: 46px;
    font-weight: 600;
    text-align: center;
    line-height: 1.5;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .biblio-body {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 56px;
    padding: 34px 0;
  }
  .cover-image {
    width: 400px; height: 570px;
    background-image: url("{{ cover_image }}");
    background-size: cover; background-position: center;
    background-color: #16161A;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.55);
    flex: 0 0 auto;
  }
  .cover-image.placeholder {
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 40px;
    font-size: 40px; line-height: 1.7; color: var(--ink-dim);
    border: 1px solid #3A3A40;
  }
  .facts { flex: 1; }
  .fact { margin-bottom: 46px; }
  .fact-label { font-size: 38px; color: var(--hl); margin-bottom: 14px; }
  .fact-value { font-size: 42px; line-height: 1.6; }
  .biblio-note {
    font-size: 30px;
    text-align: center;
    color: var(--ink-dim);
  }

  /* -------------------------------------------------- こんな方におすすめ */

  .rec-title {
    margin-top: 18px;
    font-size: 52px;
    letter-spacing: 0.05em;
    margin-bottom: 56px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .rec-list { width: 100%; max-width: 900px; }
  .rec-item {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    margin-bottom: 44px;
    text-align: left;
  }
  .check {
    flex: 0 0 auto;
    width: 46px; height: 46px;
    border: 3px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
    font-size: 34px; line-height: 1;
    margin-top: 8px;
  }
  .rec-text {
    font-size: 42px;
    line-height: 1.72;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }

  /* ------------------------------------------------------------ 最終カード */

  .outro-head {
    font-size: 44px;
    line-height: 1.75;
    max-width: 820px;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .outro-text {
    margin-top: 56px;
    font-size: 36px;
    line-height: 1.85;
    color: var(--ink-dim);
    white-space: pre-line;
    max-width: 820px;
  }
</style>
</head>
<body>

{% if variant == 'cover' %}
  <div class="card">
    <div class="cover">
      <div class="cover-left">
        <div class="top-note">{{ top_note }}</div>
        <div class="cover-title"><span>{{ text_html }}</span></div>
        <div class="cover-tag">{{ cover_tag }}</div>
        <div class="cover-foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>
      </div>
      <div class="cover-right"></div>
    </div>
  </div>

{% else %}
  <div class="card">
    <div class="bg"></div>
    <div class="veil"></div>
    <div class="layer">
      <div class="top-note">{{ top_note }}</div>

      {% if variant == 'biblio' %}
        <div class="biblio-title">{{ book_title }}</div>
        <div class="biblio-body">
          <div class="cover-image{{ '' if cover_image else ' placeholder' }}">
            {{ '' if cover_image else book_title }}
          </div>
          <div class="facts">
            <div class="fact">
              <div class="fact-label">▶ 発行日</div>
              <div class="fact-value">{{ published or '—' }}</div>
            </div>
            <div class="fact">
              <div class="fact-label">▶ 著者</div>
              <div class="fact-value">{{ book_author }}</div>
            </div>
          </div>
        </div>
        <div class="biblio-note">↓ 詳細レビューは本文から ↓</div>

      {% elif variant == 'recommend' %}
        <div class="center">
          <div class="rec-title">こんな方におすすめ</div>
          <div class="rec-list">
            {% for item in items %}
              <div class="rec-item">
                <span class="check">✓</span>
                <span class="rec-text">{{ item }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>

      {% elif variant == 'outro' %}
        <div class="center">
          <div class="outro-head">{{ account_name }}</div>
          <div class="outro-text">{{ outro_text }}</div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>

      {% else %}
        <div class="center">
          <div class="lead{{ ' small' if long_text }}">{{ text_html }}</div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

</body>
</html>
