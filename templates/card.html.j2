<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  :root {
    --ink: #FFFFFF;
    --ink-dim: #D8D4CC;
    --hl: #F2C14E;          /* 本文のハイライト（黄〜橙） */
    --hl-cover: #F05545;    /* 表紙のハイライト（赤） */
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: #0A0A0A;
    color: var(--ink);
    font-family: "Noto Serif JP", "Noto Serif CJK JP", "Hiragino Mincho ProN",
                 "Yu Mincho", "YuMincho", serif;
    -webkit-font-smoothing: antialiased;
  }

  .card {
    position: relative;
    width: {{ width }}px;
    height: {{ height }}px;
    display: flex;
    flex-direction: column;
  }

  /* 背景はぼかして沈める。文字の可読性を最優先にする。 */
  .bg {
    position: absolute;
    inset: -40px;
    background-image: url("{{ bg }}");
    background-size: cover;
    background-position: center;
    filter: blur(4px) brightness(0.78) saturate(0.9);
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center,
        rgba(6, 6, 8, 0.26) 0%, rgba(6, 6, 8, 0.60) 100%),
      linear-gradient(180deg,
        rgba(6, 6, 8, 0.62) 0%, rgba(6, 6, 8, 0.36) 42%, rgba(6, 6, 8, 0.70) 100%);
  }

  .layer {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 68px 76px 62px;
  }

  .top-note {
    font-size: 31px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .lead {
    font-size: 58px;
    font-weight: 500;
    line-height: 1.95;
    letter-spacing: 0.02em;
    white-space: pre-line;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
    max-width: 900px;
  }
  .lead.small { font-size: 50px; line-height: 2.0; }
  .hl { color: var(--hl); }

  .foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .icon {
    width: 78px; height: 78px; border-radius: 50%;
    background-image: url("{{ icon }}");
    background-size: cover; background-position: center;
    background-color: #2A2A2A;
    flex: 0 0 auto;
  }
  .icon.letter {
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; color: var(--ink-dim);
  }
  .handle { font-size: 40px; letter-spacing: 0.02em; }

  /* ------------------------------------------------------------------ 表紙 */
  /* グリッド(4:5)で切られないよう、要素をすべて中央に寄せる。 */

  .cover-frame {
    position: absolute;
    inset: 44px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    pointer-events: none;
  }
  .cover-tagline {
    text-align: center;
    font-size: 34px;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
  }
  .cover-title {
    font-size: 82px;
    font-weight: 700;
    line-height: 1.68;
    letter-spacing: 0.01em;
    white-space: pre-line;
    text-align: center;
    text-shadow: 0 4px 26px rgba(0, 0, 0, 0.75);
  }
  .cover-title .hl { color: var(--hl-cover); }
  .cover-tag {
    font-size: 34px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    margin-bottom: 32px;
    text-align: center;
  }

  /* -------------------------------------------------------------- 書誌情報 */

  .biblio-title {
    margin-top: 40px;
    font-size: 48px;
    font-weight: 600;
    text-align: center;
    line-height: 1.5;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .biblio-body {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 54px;
    padding: 44px 0;
  }
  .cover-image {
    width: 420px; height: 600px;
    background-image: url("{{ cover_image }}");
    background-size: cover; background-position: center;
    background-color: #16161A;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.6);
    flex: 0 0 auto;
  }
  .cover-image.placeholder {
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 40px;
    font-size: 40px; line-height: 1.7; color: var(--ink-dim);
    border: 1px solid #3A3A40;
  }
  .facts { flex: 1; }
  .fact { margin-bottom: 52px; }
  .fact-label { font-size: 38px; color: var(--hl); margin-bottom: 16px; }
  .fact-value { font-size: 42px; line-height: 1.6; }
  .biblio-note { font-size: 31px; text-align: center; color: var(--ink-dim); }

  /* ---------------------------------------------------- こんな方におすすめ */

  .rec-title {
    margin-top: 24px;
    font-size: 56px;
    letter-spacing: 0.05em;
    margin-bottom: 64px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .rec-list { width: 100%; max-width: 900px; }
  .rec-item {
    display: flex; align-items: flex-start; gap: 28px;
    margin-bottom: 52px; text-align: left;
  }
  .check {
    flex: 0 0 auto; width: 48px; height: 48px;
    border: 3px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
    font-size: 34px; line-height: 1; margin-top: 10px;
  }
  .rec-text {
    font-size: 44px; line-height: 1.75;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }

  /* ------------------------------------------------------------ 最終カード */

  .outro-head {
    white-space: pre-line;
    font-size: 48px;
    line-height: 1.8;
    max-width: 860px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .outro-text {
    margin-top: 64px;
    font-size: 38px;
    line-height: 1.9;
    color: var(--ink-dim);
    white-space: pre-line;
    max-width: 860px;
  }
</style>
</head>
<body>

<div class="card">
  <div class="bg"></div>
  <div class="veil"></div>

  {% if variant == 'cover' %}
    <div class="cover-frame"></div>
    <div class="layer">
      <div class="cover-tagline">{{ top_note }}</div>
      <div class="center">
        <div class="cover-title" style="font-size: {{ font_size }}px">{{ text_html }}</div>
      </div>
      <div class="cover-tag">{{ cover_tag }}</div>
      <div class="foot">
        <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
        <span class="handle">{{ handle }}</span>
      </div>
    </div>

  {% else %}
    <div class="layer">
      <div class="top-note">{{ top_note }}</div>

      {% if variant == 'biblio' %}
        <div class="biblio-title">{{ book_title }}</div>
        <div class="biblio-body">
          <div class="cover-image{{ '' if cover_image else ' placeholder' }}">
            {{ '' if cover_image else book_title }}
          </div>
          <div class="facts">
            <div class="fact">
              <div class="fact-label">▶ 発行日</div>
              <div class="fact-value">{{ published or '—' }}</div>
            </div>
            <div class="fact">
              <div class="fact-label">▶ 著者</div>
              <div class="fact-value">{{ book_author }}</div>
            </div>
          </div>
        </div>
        <div class="biblio-note">↓ 詳細レビューは本文から ↓</div>

      {% elif variant == 'recommend' %}
        <div class="center">
          <div class="rec-title">こんな方におすすめ</div>
          <div class="rec-list">
            {% for item in items %}
              <div class="rec-item">
                <span class="check">✓</span>
                <span class="rec-text">{{ item }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>

      {% elif variant == 'outro' %}
        <div class="center">
          <div class="outro-head">{{ account_name }}</div>
          <div class="outro-text">{{ outro_text }}</div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>

      {% else %}
        <div class="center">
          <div class="lead" style="font-size: {{ font_size }}px">{{ text_html }}</div>
        </div>
        <div class="foot">
          <div class="icon{{ ' letter' if not icon }}">{{ '' if icon else 'A' }}</div>
          <span class="handle">{{ handle }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

</body>
</html>
